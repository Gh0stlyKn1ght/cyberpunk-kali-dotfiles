#!/usr/bin/env bash
set -euo pipefail

ROOT="${CYBERKALI_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
if [ ! -f "$ROOT/installer/common.sh" ]; then
  STATE_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/cyberkali/root"
  if [ -r "$STATE_ROOT" ]; then ROOT="$(cat "$STATE_ROOT")"; fi
fi
if [ ! -f "$ROOT/installer/common.sh" ]; then printf 'CyberKali runtime could not locate its project root. Re-run install.sh.\n' >&2; exit 1; fi

export CYBERKALI_ROOT="$ROOT"
. "$ROOT/installer/common.sh"
. "$ROOT/installer/packages.sh"
AGS_INSTANCE="cyberkali"
FAVORITES_FILE="$CYBERKALI_CONFIG_DIR/favorites"

usage() {
  cat <<'EOF'
CyberKali control utility

Usage:
  cyberkali flavor [red|cyan|amber]
  cyberkali cycle
  cyberkali start|stop|restart
  cyberkali launcher|netwatch|media|messages|controls|power
  cyberkali notification-actions
  cyberkali dnd
  cyberkali hud-layer
  cyberkali workspace-test [1..10]
  cyberkali notify-test [title] [body]
  cyberkali streetcred-test [package] [version]
  cyberkali monitors
  cyberkali tool-search <term>
  cyberkali favorite add|remove|list [binary]
  cyberkali doctor
  cyberkali status
EOF
}

current_flavor() { if [ -r "$CYBERKALI_CONFIG_DIR/flavor" ]; then cat "$CYBERKALI_CONFIG_DIR/flavor"; else printf 'red\n'; fi; }
request_shell() { local request="$1"; if ! have ags; then fail "AGS runtime missing"; return 1; fi; ags request "$request" --instance "$AGS_INSTANCE"; }
start_shell() { ensure_dirs; have ags || { fail "AGS runtime is missing. Run cyberkali doctor."; return 1; }; ags quit --instance "$AGS_INSTANCE" >/dev/null 2>&1 || true; nohup ags run "$ROOT/config/ags/app.ts" >>"$CYBERKALI_STATE_DIR/ags.log" 2>&1 & disown || true; ok "CyberKali shell started"; }
stop_shell() { if have ags; then ags quit --instance "$AGS_INSTANCE" >/dev/null 2>&1 || true; fi; ok "CyberKali shell stopped"; }
reload_shell() { if have ags; then stop_shell >/dev/null; start_shell; fi; }

set_flavor() {
  local flavor="${1:-}" no_reload="${2:-}"
  case "$flavor" in red|cyan|amber) ;; *) fail "Flavor must be red, cyan, or amber"; exit 2 ;; esac
  ensure_dirs
  cat > "$ROOT/config/ags/styles/active.scss" <<EOF
// Generated by cyberkali. Do not edit directly.
@forward "flavors/$flavor";
EOF
  printf '%s\n' "$flavor" > "$CYBERKALI_CONFIG_DIR/flavor"
  if have sassc; then sassc "$ROOT/config/ags/styles/main.scss" "$ROOT/config/ags/styles/main.css"; sassc "$ROOT/config/ags/styles/fidelity.scss" "$ROOT/config/ags/styles/fidelity.css" || true; ok "Compiled $flavor stylesheets"; else warn "sassc not installed. Flavor selected but CSS was not compiled."; fi
  ok "Flavor set to $flavor"
  if [ "$no_reload" != "--no-reload" ]; then reload_shell; fi
}
cycle_flavor() { case "$(current_flavor)" in red) set_flavor cyan ;; cyan) set_flavor amber ;; amber|*) set_flavor red ;; esac; }

monitor_report() {
  if ! have hyprctl; then fail "hyprctl missing"; return 1; fi
  hyprctl monitors -j | jq -r '.[] | "\(.name)  \(.width)x\(.height)@\(.refreshRate|floor)  scale=\(.scale)  pos=\(.x),\(.y)  workspace=\(.activeWorkspace.id)"'
}

tool_search() {
  local q="${*:-}"
  [ -n "$q" ] || { fail "Usage: cyberkali tool-search <term>"; return 2; }
  printf '%bCYBERKALI // KALI PACKAGE SEARCH%b\n' "$BOLD" "$RESET"
  apt-cache search --names-only "$q" 2>/dev/null | head -n 30
}

favorite_cmd() {
  local op="${1:-list}" item="${2:-}"
  ensure_dirs
  touch "$FAVORITES_FILE"
  case "$op" in
    list) grep -v '^$' "$FAVORITES_FILE" || true ;;
    add)
      [ -n "$item" ] || { fail "Usage: cyberkali favorite add <binary>"; return 2; }
      grep -Fxq "$item" "$FAVORITES_FILE" || printf '%s\n' "$item" >> "$FAVORITES_FILE"
      ok "Favorite added: $item"
      ;;
    remove)
      [ -n "$item" ] || { fail "Usage: cyberkali favorite remove <binary>"; return 2; }
      tmp="${FAVORITES_FILE}.tmp"
      grep -Fxv "$item" "$FAVORITES_FILE" > "$tmp" || true
      mv "$tmp" "$FAVORITES_FILE"
      ok "Favorite removed: $item"
      ;;
    *) fail "favorite expects add, remove, or list"; return 2 ;;
  esac
}

status() {
  printf '%bCYBERKALI // STATUS%b\n' "$BOLD" "$RESET"
  printf 'root       %s\n' "$ROOT"
  printf 'flavor     %s\n' "$(current_flavor)"
  printf 'hyprland   %s\n' "$(have hyprctl && echo detected || echo missing)"
  printf 'ags        %s\n' "$(have ags && echo detected || echo missing)"
  printf 'notifd     %s\n' "$(pkg-config --exists astal-notifd-0.1 2>/dev/null && echo detected || echo missing)"
  printf 'powerprof  %s\n' "$(have powerprofilesctl && powerprofilesctl get 2>/dev/null || echo unavailable)"
  printf 'favorites  %s\n' "$([ -r "$FAVORITES_FILE" ] && grep -cv '^$' "$FAVORITES_FILE" || echo 0)"
  if have hyprctl; then printf 'monitors   %s\n' "$(hyprctl monitors -j 2>/dev/null | jq 'length' 2>/dev/null || echo unknown)"; fi
  if have pgrep && pgrep -f 'ags run.*config/ags/app.ts' >/dev/null 2>&1; then printf 'shell      running\n'; else printf 'shell      stopped\n'; fi
  if have systemctl && systemctl --user is-active --quiet cyberkali-package-watch.service 2>/dev/null; then printf 'pkg watcher active\n'; else printf 'pkg watcher inactive\n'; fi
}

doctor() {
  local failures=0 warnings=0 command package
  printf '%bCYBERKALI // SYSTEM DIAGNOSTICS%b\n\n' "$BOLD" "$RESET"
  if is_kali; then ok "Kali/Debian base detected"; else warn "Kali not positively identified"; warnings=$((warnings+1)); fi
  for command in hyprctl gjs sassc grim slurp wf-recorder wl-copy nmcli wpctl playerctl jq ip loginctl systemctl apt-cache dpkg-query; do
    if have "$command"; then ok "$command"; else
      case "$command" in hyprctl|gjs|sassc|nmcli|wpctl|ip|loginctl|systemctl|apt-cache|dpkg-query) fail "$command missing"; failures=$((failures+1)) ;; *) warn "$command missing, related feature will be disabled"; warnings=$((warnings+1)) ;; esac
    fi
  done
  for command in brightnessctl bluetoothctl powerprofilesctl; do if have "$command"; then ok "$command optional control"; else warn "$command missing; related control will show N/A"; warnings=$((warnings+1)); fi; done
  if have ags; then ok "AGS runtime"; else fail "AGS runtime missing"; failures=$((failures+1)); fi
  for pc in astal-io-0.1 astal-3.0 astal-4.0 astal-notifd-0.1; do if pkg-config --exists "$pc" 2>/dev/null; then ok "$pc"; else fail "$pc missing"; failures=$((failures+1)); fi; done
  if have hyprctl; then
    local mcount; mcount="$(hyprctl monitors -j 2>/dev/null | jq 'length' 2>/dev/null || echo 0)"
    if [ "$mcount" -gt 0 ] 2>/dev/null; then ok "Hyprland monitor registry: $mcount display(s)"; else fail "Hyprland reports no active monitors"; failures=$((failures+1)); fi
  fi
  if busctl --user status org.freedesktop.Notifications >/dev/null 2>&1; then ok "Freedesktop notification bus owner present"; else warn "No active org.freedesktop.Notifications owner yet"; warnings=$((warnings+1)); fi
  scan_packages
  for package in "${UNAVAILABLE_REQUIRED[@]}"; do fail "APT runtime package unavailable: $package"; failures=$((failures+1)); done
  for package in "${MISSING_REQUIRED[@]}"; do fail "Required runtime package not installed: $package"; failures=$((failures+1)); done
  for package in "${UNAVAILABLE_BUILD[@]}"; do warn "Source-build dependency unavailable: $package"; warnings=$((warnings+1)); done
  for package in "${MISSING_BUILD[@]}"; do warn "Source-build dependency not installed: $package"; warnings=$((warnings+1)); done
  if [ -n "${WAYLAND_DISPLAY:-}" ]; then ok "Wayland session: $WAYLAND_DISPLAY"; else warn "Not currently inside a Wayland session"; warnings=$((warnings+1)); fi
  [ -r "$ROOT/config/ags/app.ts" ] && ok "AGS app entrypoint" || { fail "AGS app entrypoint missing"; failures=$((failures+1)); }
  [ -r /var/log/dpkg.log ] && ok "dpkg event log readable" || { warn "dpkg log unavailable; Street Cred watcher disabled"; warnings=$((warnings+1)); }
  printf '\nDiagnostics: %d failure(s), %d warning(s)\n' "$failures" "$warnings"
  [ "$failures" -eq 0 ]
}

command="${1:-help}"; shift || true
case "$command" in
  flavor) if [ $# -eq 0 ]; then current_flavor; else set_flavor "$@"; fi ;;
  cycle) cycle_flavor ;;
  start) start_shell ;; stop) stop_shell ;; restart) reload_shell ;;
  launcher|netwatch|media|controls|power) request_shell "$command" ;;
  messages) request_shell notifications ;;
  notification-actions) request_shell notification-actions ;;
  dnd) request_shell notification-dnd ;;
  hud-layer) request_shell hud-layer ;;
  workspace-test) request_shell "workspace-glitch|${1:-1}" ;;
  notify-test) request_shell "notify|${1:-SYSTEM TEST}|${2:-CyberKali notification path operational}" ;;
  streetcred-test) request_shell "streetcred|${1:-nmap}|${2:-test}" ;;
  monitors) monitor_report ;;
  tool-search) tool_search "$@" ;;
  favorite) favorite_cmd "$@" ;;
  doctor) doctor ;; status) status ;;
  help|-h|--help) usage ;;
  *) fail "Unknown command: $command"; usage; exit 2 ;;
esac
